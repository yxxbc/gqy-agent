// 模块层序图 —— 顾清影 gqy 现状
// 层序表真相源: test_scripts/arch_dep_check.py:48-64
// 反向边（低层→高层）真相源: test_scripts/arch-dep-waivers.json（18 条边 / 69 处引用）
// 正向（合规的下行）依赖约 190 条，本图刻意不画：画了就看不清债在哪。
// 渲染: dot -Tsvg layers.dot -o layers.svg   （rankdir=TB：纵向，密集关系图适合竖排）
digraph layers {
  rankdir=TB;
  newrank=true;
  nodesep=0.22;
  ranksep=0.7;
  fontname="Helvetica";
  labelloc=t;
  label="gqy 顶层模块层序 + 现存反向依赖（低层 → 高层）\n实线红=白名单内的反向边，边上数字=代码引用处数\n生成 2026-09-26 · system-modeler";
  fontsize=15;

  node [shape=box, style="rounded,filled", fillcolor="#F4F6F7", color="#566573",
        fontname="Menlo", fontsize=11, margin="0.12,0.04"];
  edge [color="#C0392B", penwidth=1.3, fontsize=9, fontcolor="#922B21", labeldistance=1.6];

  subgraph cluster_L0 {
    label="L0 基础"; style="rounded,filled"; fillcolor="#FBEEE6"; color="#E59866"; fontsize=12;
    i18n; paths; shell; prompts; logging; notify; json_extract; token_counter;
    token_estimate; memory_types; platform_types; slash_commands;
  }
  subgraph cluster_L1 {
    label="L1 配置"; style="rounded,filled"; fillcolor="#FCF3CF"; color="#D4AC0D"; fontsize=12;
    config; default_models; models_cache;
  }
  subgraph cluster_L2 {
    label="L2 基础设施"; style="rounded,filled"; fillcolor="#EAF2F8"; color="#2E86C1"; fontsize=12;
    llm; state; embedding; ipc; question; alarm; skills; pm; transfer; voice;
    terminal; persona_hint; args;
  }
  subgraph cluster_L3 {
    label="L3 能力"; style="rounded,filled"; fillcolor="#E9F7EF"; color="#1E8449"; fontsize=12;
    tools; memory; render; ledger; clipboard; host_info; default_kb;
  }
  subgraph cluster_L4 {
    label="L4 回合引擎"; style="rounded,filled"; fillcolor="#F4ECF7"; color="#7D3C98"; fontsize=12;
    agent; runtime;
  }
  subgraph cluster_L5 {
    label="L5 场所"; style="rounded,filled"; fillcolor="#FDEDEC"; color="#C0392B"; fontsize=12;
    platforms;
  }
  subgraph cluster_L6 {
    label="L6 daemon"; style="rounded,filled"; fillcolor="#EBF5FB"; color="#154360"; fontsize=12;
    web;
  }
  subgraph cluster_L7 {
    label="L7 入口"; style="rounded,filled"; fillcolor="#F2F3F4"; color="#797D7F"; fontsize=12;
    cli; config_tui; question_tui; oobe; daemon;
  }

  // 层序本身用不可见的「合法下行边」钉住：选每层一个代表模块，串成一条
  // 自上而下的链。用节点而不是 cluster 之间连线，避免跨 cluster 边的兼容问题。
  edge [style=invis, color=invisible, label="", penwidth=1];
  paths -> config -> state -> tools -> agent -> platforms -> web -> cli;

  // ── 18 条反向边（门禁放行、按现状记数）──────────────────────────
  edge [style=solid, color="#C0392B", penwidth=1.3, fontsize=9, fontcolor="#922B21"];

  llm    -> tools       [label="15", penwidth=3.0];
  tools  -> agent       [label="9",  penwidth=2.4];
  agent  -> platforms   [label="8",  penwidth=2.2];
  tools  -> platforms   [label="5"];
  tools  -> web         [label="5"];
  platforms -> web      [label="4"];
  runtime -> platforms  [label="4"];
  web    -> cli         [label="4"];
  config -> state       [label="2"];
  models_cache -> runtime [label="2"];
  render -> cli         [label="2"];
  tools  -> cli         [label="2"];
  web    -> config_tui  [label="2"];
  llm    -> platforms   [label="1"];
  llm    -> render      [label="1"];
  state  -> tools       [label="1"];
  terminal -> cli       [label="1"];
  tools  -> runtime     [label="1"];
}
