LINE_NAMES = ["初爻", "二爻", "三爻", "四爻", "五爻", "上爻"]

def cast_hexagram():
    lines_primary = []
    lines_transformed = []
    toss_details = []
    changing_positions = []

    for idx in range(6):
        coins = [random.choice([2, 3]) for _ in range(3)]
        total = sum(coins)
        if total == 6:
            p_val, t_val = 0, 1
            line_type = "老阴 (⚋ 变 ⚊)"
            changing_positions.append(idx + 1)
        elif total == 7:
            p_val, t_val = 1, 1
            line_type = "少阳 (⚊)"
        elif total == 8:
            p_val, t_val = 0, 0
            line_type = "少阴 (⚋)"
        else:
            p_val, t_val = 1, 0
            line_type = "老阳 (⚊ 变 ⚋)"
            changing_positions.append(idx + 1)

        lines_primary.append(p_val)
        lines_transformed.append(t_val)
        toss_details.append({
            "line": LINE_NAMES[idx],
            "position": idx + 1,
            "coins": coins,
            "sum": total,
            "type": line_type,
            "changing": total in (6, 9)
        })

    lower_p = tuple(lines_primary[0:3])
    upper_p = tuple(lines_primary[3:6])
    lower_t = tuple(lines_transformed[0:3])
    upper_t = tuple(lines_transformed[3:6])

    trigram_lower_p = TRIGRAMS[lower_p]["name"]
    trigram_upper_p = TRIGRAMS[upper_p]["name"]
    name_p, text_p, desc_p = HEXAGRAM_TABLE.get((trigram_upper_p, trigram_lower_p), ("未知卦", "", ""))

    transformed_info = None
    if changing_positions:
        trigram_lower_t = TRIGRAMS[lower_t]["name"]
        trigram_upper_t = TRIGRAMS[upper_t]["name"]
        name_t, text_t, desc_t = HEXAGRAM_TABLE.get((trigram_upper_t, trigram_lower_t), ("未知卦", "", ""))
        transformed_info = {
            "name": name_t,
            "upper_trigram": trigram_upper_t,
            "lower_trigram": trigram_lower_t,
            "text": text_t,
            "essence": desc_t
        }

    return {
        "ok": True,
        "primary": {
            "name": name_p,
            "upper_trigram": trigram_upper_p,
            "lower_trigram": trigram_lower_p,
            "text": text_p,
            "essence": desc_p
        },
        "changing_lines": [f"{LINE_NAMES[pos - 1]}" for pos in changing_positions],
        "transformed": transformed_info,
        "lines_from_bottom_to_top": toss_details
    }

def main():
    raw = os.environ.get("GQY_ARGS_JSON")
    if not raw:
        if not sys.stdin.isatty():
            raw = sys.stdin.read()
        else:
            raw = "{}"
    try:
        args = json.loads(raw) if raw.strip() else {}
    except Exception:
        args = {}
    question = args.get("question", "运势与心意")
    result = cast_hexagram()
    result["question"] = question
    print(json.dumps(result, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
