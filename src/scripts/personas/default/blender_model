#!/usr/bin/env python3
# Display name: Blender 3D 建模与渲染
# Description: Control Blender for 3D modeling, rendering and export. Covers procedural assets, bpy code, model export (.glb/.gltf/.obj/.blend) and scene renders. Uses the open Blender viewport when there is one, otherwise a headless background Blender.
# Timeout: 180
# Group: creative
# Parameters:
# {
#   "type": "object",
#   "properties": {
#     "action": {
#       "type": "string",
#       "enum": ["status", "run_code", "create_asset", "render", "export"],
#       "description": "status: 检查连接与版本; run_code: 执行自定义 bpy 代码; create_asset: 参数化生成常见道具/模型; render: 渲染当前场景成图片; export: 导出模型文件(.glb/.obj/.blend等)"
#     },
#     "code": {
#       "type": "string",
#       "description": "Python bpy 脚本代码（run_code 或辅助操作使用）"
